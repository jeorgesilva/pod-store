# Copy this file to .dev.vars for local development (wrangler dev reads it
# automatically). .dev.vars is git-ignored — never commit real keys.
# For production, set the same names with: wrangler secret put NAME

PRINTFUL_API_KEY=your_printful_private_token
# Private token with the "Embedded Designer" extension AND
# "development purposes only" checked — a *different* token than
# PRINTFUL_API_KEY. Create it in the Printful dashboard. See README.md.
PRINTFUL_EDM_TOKEN=your_printful_edm_dev_token
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_signing_secret

# Historical — Gelato/Montink are no longer the active POD_PROVIDER (see
# CLAUDE.md), only needed if you switch back to one of them.
# GELATO_API_KEY=your_gelato_sandbox_api_key
# MONTINK_API_KEY=your_montink_api_key
